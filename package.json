{
  "name": "disk-reaper",
  "version": "1.4.8",
  "description": "All-in-one system utility for Windows and macOS: clean disk space, tune performance, manage installed apps, services and processes, fix networking, and apply privacy and system tweaks.",
  "main": "main.js",
  "author": "EERIE",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:appx": "electron-builder --win appx",
    "dist:mac": "electron-builder --mac",
    "dist:dmg": "electron-builder --mac dmg",
    "dist:zip": "electron-builder --mac zip"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "files": [
      "main.js",
      "src/**/*",
      "build/**/*",
      "!node_modules",
      "!dist",
      "!.git"
    ],
    "asarUnpack": [
      "src/win/scripts/**/*"
    ],
    "appId": "com.eerie.largefilefinder",
    "productName": "Disk Reaper",
    "copyright": "© 2025 EERIE",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "appx",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "appx": {
      "identityName": "20715EerieGoesD.DiskReaper",
      "publisher": "CN=A2A89A47-0B2B-4C32-B85C-9753888A9FFC",
      "publisherDisplayName": "EERIE",
      "applicationId": "DiskReaper",
      "displayName": "Disk Reaper",
      "backgroundColor": "#0a0a0c",
      "languages": ["en-US"]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Disk Reaper",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
